{
  "name": "totem",
  "version": "1.0.0",
  "description": "Selective Minecraft configuration backup TUI",
  "license": "MIT",
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-env --allow-run src/main.ts",
    "check": "deno check src/main.ts tests/**/*.ts",
    "test": "deno test --allow-read --allow-write tests/",
    "test:watch": "deno test --watch --allow-read --allow-write tests/",
    "compile": "deno eval \"await Deno.mkdir('dist', { recursive: true });\" && deno compile --allow-read --allow-write --allow-env --allow-run --output dist/totem src/main.ts"
  },
  "exports": "./src/main.ts",
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.7",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.0.0-rc.7",
    "@cliffy/table": "jsr:@cliffy/table@^1.0.0-rc.7",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/path/": "jsr:@std/path@^1.0.8/",
    "@std/assert": "jsr:@std/assert@^1.0.9"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["dist/"]
  },
  "lint": {
    "exclude": ["dist/"]
  }
}
